<?xml version="1.0" encoding="utf-8"?>
<!-- Android TV launcher banner (320x180 dp slot). Drawn as a layer-list instead of a PNG so the
     repo keeps no generated binaries: dark violet plate + the app icon centered on it. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#12091F" />
        </shape>
    </item>
    <item
        android:gravity="center"
        android:width="96dp"
        android:height="96dp">
        <bitmap android:src="@mipmap/ic_launcher" android:gravity="center" />
    </item>
</layer-list>
