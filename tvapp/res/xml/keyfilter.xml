<?xml version="1.0" encoding="utf-8"?>
<!-- Служба нужна ровно ради одного права — видеть нажатия клавиш. Содержимое экрана не читаем.
     ВАЖНО: одного canRequestFilterKeyEvents мало (он лишь разрешает просить клавиши) —
     без flagRequestFilterKeyEvents в accessibilityFlags onKeyEvent не вызывается вообще. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:canRequestFilterKeyEvents="true"
    android:accessibilityFlags="flagRequestFilterKeyEvents|flagDefault"
    android:notificationTimeout="100"
    android:description="@string/keyservice_desc" />
