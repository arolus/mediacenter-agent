<?xml version="1.0" encoding="utf-8"?>
<!-- versionCode/versionName проставляет build.sh флагами aapt2 link при сборке -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.mediacenter.tv">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Android TV (Xiaomi TV Box S и т.п.): без этих двух строк приставка считает приложение
         несовместимым и не показывает его в лаунчере — у неё нет тачскрина, а leanback-оболочку
         мы не используем (интерфейс свой, на D-pad он и так рассчитан). -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <application
        android:label="MediaCenter TV"
        android:icon="@mipmap/ic_launcher"
        android:banner="@drawable/banner"
        android:allowBackup="false"
        android:usesCleartextTraffic="true"
        android:theme="@style/TvTheme">
        <!-- singleTask: повторный am start от агента не плодит копий (и не плодит SSE-клиентов) -->
        <activity
            android:name=".MainActivity"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|keyboard|keyboardHidden|density|screenLayout|smallestScreenSize|uiMode"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- иконка в лаунчере Android TV (телефоны её игнорируют) -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <!-- Родительский режим: приложение может быть домашним экраном приставки. Тогда она
                 включается сразу в медиатеку, а кнопка Home возвращает сюда же; выйти в Google TV
                 можно лишь по коду (TV-страница → /api/kiosk-exit). Назначается это НЕ здесь, а
                 выбором лаунчера по умолчанию: `cmd package set-home-activity` или диалог системы,
                 так что на телефоне-ноде поведение не меняется. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <!-- Cloudflare clearance harvester: agent starts it when rutracker challenges us.
             Not a launcher entry — no MAIN/LAUNCHER filter, only `am start -n …/.ClearanceActivity` -->
        <activity
            android:name=".ClearanceActivity"
            android:label="rutracker"
            android:exported="true" />
        <!-- Device Admin — только ради lockNow() (гасить экран после простоя) -->
        <receiver
            android:name=".AdminReceiver"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:exported="true">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
